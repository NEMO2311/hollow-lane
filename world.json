          "details": {
            "title": "Halloween lore: why we dress up",
            "text": "Two thousand years ago the Celts of Ireland and Britain kept Samhain on the night of 31 October, when they believed the dead walked close to the living. People wore disguises so wandering spirits would take them for one of their own. The masks and costumes of Halloween descend from that night.\n",
            "facts": [
              [
                "Festival",
                "Samhain, Celtic new year"
              ],
              [
                "Date",
                "31 October to 1 November"
              ],
              [
                "Costumes in America",
                "common from the 1920s"
              ]
            ]
          },
          "film": {
            "src": "films/hall-portraits.mp4",
            "src720": "films/hall-portraits-720.mp4",
            "seconds": 6.583
          },
          "reveal": {
            "still": "stills/reveals/hall-portraits.webp",
            "narration": {
              "lines": [
                {
                  "text": "1955. 1959. 1962. 1967. 1971. 1979. A child every few Halloweens. Every one of them took a second candy, and the night never let them go."
                }
              ]
            },
