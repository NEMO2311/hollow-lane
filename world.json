    {
      "id": "dawn",
      "title": "Midnight at Last",
      "still": "stills/dawn.webp",
      "loop": {
        "src": "films/dawn-loop.mp4",
        "src720": "films/dawn-loop-720.mp4",
        "seconds": 8
      },
      "narration": null,
      "ending": {
        "kind": "end",
        "title": "The Night Ends",
        "text": "The candle went out, and for the first time in thirty years the clock struck twelve. On All Hallows' Eve the dead come home at midnight, and Mrs. Whitlock's promise had held the night one minute short of it. She was never the villain of this house, only a mother who could not stop waiting. Tommy came down the steps in his cowboy hat and took her hand, and then the light grew until they were gone. For the first time since 1955 it is morning in the house on Hollow Lane. Nobody on the street will ever believe you. But you know Tommy finally got home.\n"
      },
      "hotspots": []
    },
    {
      "id": "portrait",
      "title": "The Newest Portrait",
      "still": "stills/portrait.webp",
      "loop": null,
      "narration": null,
      "ending": {
        "kind": "death",
        "title": "Forever Guest",
        "text": "One candy each, the sign said, and you took a second. The candles guttered, the paint in the newest frame ran and swirled, and when it dried it was you looking out, bedsheet, pail and all. Now you hang in the hall with the others, and every few years a new child stops to look at you. The portraits will keep you company for as long as the first pumpkin burns.\n"
      },
      "hotspots": []
    },
    {
      "id": "mirror",
      "title": "Through the Glass",
      "still": "stills/mirror.webp",
      "loop": null,
      "narration": null,
      "ending": {
        "kind": "death",
        "title": "The Other Side of the Glass",
        "text": "Your reflection took your hand, and then your place. It walked out of the house on your feet at dawn. You are still in the mirror in Tommy's room, waving to anyone who comes in. In the glass it is always the same night, and somewhere below the house the first pumpkin keeps it that way.\n"
      },
      "hotspots": []
    },
    {
      "id": "mannequin",
      "title": "Dressed for the Party",
      "still": "stills/mannequin.webp",
      "loop": null,
      "narration": null,
      "ending": {
        "kind": "death",
        "title": "Dressed for the Party",
        "text": "It fit perfectly. That was the trouble. Now you stand in the attic with the others, in a clean white sheet, ready for a party that starts at midnight and never begins. The attic is cold, but somewhere beneath the house one old candle keeps this night from ending.\n"
      },
      "hotspots": []
    },
    {
      "id": "guest",
      "title": "Guest of Honour",
      "still": "stills/guest.webp",
      "loop": null,
      "narration": null,
      "ending": {
        "kind": "death",
        "title": "Guest of Honour",
        "text": "You sat down, and the party began. The cake never runs out, the record never ends, and the clock never quite strikes twelve. Mrs. Whitlock finally has someone to celebrate with. As long as the first pumpkin burns downstairs, it will always be tonight.\n"
      },
      "hotspots": []
    }
  ]
